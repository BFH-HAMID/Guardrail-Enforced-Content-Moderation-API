# Copy to deploy/.env and fill in. Everything here maps to a GUARD_* setting in app/core/config.py.

# --- required ---------------------------------------------------------------------------------
# Keys created on first boot (comma separated). Stored only as salted SHA-256 digests; the raw
# value never touches the DB, so lose it and you issue a new one.
# Generate: python -c "import secrets,string; print('gmk_' + ''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(32)))"
GUARD_BOOTSTRAP_API_KEYS=gmk_replace-me-with-a-32-char-secret
GUARD_API_KEY_PEPPER=another-distinct-secret     # mixed into the hash so a stolen DB is not rainbow-tableable
POSTGRES_PASSWORD=replace-me-too

# --- tuning -----------------------------------------------------------------------------------
GUARD_DEFAULT_MODE=balanced          # strict | balanced | lenient
GUARD_STAGE3_MODE=passthrough        # passthrough (moderation proxy) | assistant (answers itself)
GUARD_RATE_LIMIT_REQUESTS_PER_MINUTE=120   # per key
GUARD_RATE_LIMIT_BURST=20
GUARD_PIPELINE_REQUEST_TIMEOUT_S=60 # hard ceiling; the chain fails closed past it

# --- LLM (optional) ----------------------------------------------------------------------------
# Empty provider order => rules-only, fully offline. Set it to turn on the Stage 1 judge,
# the Stage 2 rewrite and Stage 3 answers.
GUARD_LLM_FALLBACK_ORDER=local>ollama
#GUARD_LLM_FALLBACK_ORDER=gemini>openai
#GUARD_GEMINI_API_KEY=
#GUARD_GEMINI_BASE_URL=            # OpenAI-compatible endpoint (vLLM / Ollama / a gateway)
#GUARD_SMALL_MODEL=gemini-2.0-flash-lite
#GUARD_MAIN_MODEL=gemini-2.0-flash

# --- privacy ----------------------------------------------------------------------------------
GUARD_LOG_REQUEST_BODIES=false           # full request bodies in the *application* log
GUARD_STORE_RAW_INPUT=true               # store input text in the audit row (hash + preview otherwise)
GUARD_STORE_MAX_CHARS=4000
GUARD_ENCRYPT_STORED_TEXT=false          # at-rest encryption for stored text
#GUARD_USER_ID_HASH_SALT=rotate-me        # hashes of caller-supplied user ids
GUARD_RETENTION_DAYS=30                    # 0 disables the sweep entirely
#GUARD_RETENTION_SWEEP_INTERVAL_S=21600

# --- misc -------------------------------------------------------------------------------------
GUARD_ENVIRONMENT=staging
GUARD_PORT=8000
GUARD_UI_PORT=8501
GUARD_IMAGE_TAG=local
#GUARD_CORS_ORIGINS=https://mod.example.com
#GUARD_POLICIES_PATH=/srv/app/config/policies.yaml
#GUARD_STORE_TRACE=true                   # per-stage trace persisted for /explain
#GUARD_MAX_INPUT_CHARS=8000
